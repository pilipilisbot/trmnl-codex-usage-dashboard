{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TRMNL Codex usage webhook payload v2",
  "type": "object",
  "required": ["merge_variables"],
  "additionalProperties": false,
  "properties": {
    "merge_variables": {
      "type": "object",
      "required": ["updated_at", "quotas", "daily_usage", "models", "recent"],
      "additionalProperties": false,
      "properties": {
        "account_label": { "type": "string", "maxLength": 32 },
        "updated_at": { "type": "string", "maxLength": 32 },
        "quotas": {
          "type": "array", "maxItems": 3,
          "items": {
            "type": "object", "required": ["label", "used_pct", "used", "limit", "reset"], "additionalProperties": false,
            "properties": {
              "label": { "type": "string", "maxLength": 32 },
              "used_pct": { "$ref": "#/$defs/pct" },
              "used": { "type": "string", "maxLength": 20 },
              "limit": { "type": "string", "maxLength": 20 },
              "reset": { "type": "string", "maxLength": 32 }
            }
          }
        },
        "daily_usage": { "type": "array", "maxItems": 7, "items": { "$ref": "#/$defs/percentage_item" } },
        "models": {
          "type": "array", "maxItems": 4,
          "items": {
            "type": "object", "required": ["name", "pct", "value"], "additionalProperties": false,
            "properties": {
              "name": { "type": "string", "maxLength": 24 },
              "pct": { "$ref": "#/$defs/pct" },
              "value": { "type": "string", "maxLength": 12 }
            }
          }
        },
        "recent": {
          "type": "array", "maxItems": 4,
          "items": {
            "type": "object", "required": ["label", "value"], "additionalProperties": false,
            "properties": {
              "label": { "type": "string", "maxLength": 24 },
              "value": { "type": "string", "maxLength": 12 }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "pct": { "type": "integer", "minimum": 0, "maximum": 100 },
    "percentage_item": {
      "type": "object", "required": ["label", "pct"], "additionalProperties": false,
      "properties": {
        "label": { "type": "string", "maxLength": 12 },
        "pct": { "$ref": "#/$defs/pct" }
      }
    }
  }
}
