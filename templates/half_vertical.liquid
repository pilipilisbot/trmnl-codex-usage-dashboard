<link rel="stylesheet" href="https://trmnl.com/css/latest/plugins.css">
<style>
  .codex-half-vertical { font-family: system-ui, sans-serif; }
  .codex-half-vertical .quota-stack { display: grid; grid-template-rows: repeat(3, minmax(0, 1fr)); gap: 9px; height: 398px; }
  .codex-half-vertical .quota-card { border: 2px solid #000; border-radius: 6px; padding: 9px; overflow: hidden; }
  .codex-half-vertical .label { font-size: 18px; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .codex-half-vertical .percent { font-size: 30px; line-height: 1.1; font-weight: 800; }
  .codex-half-vertical .detail { font-size: 13px; margin-top: 3px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .codex-half-vertical .meter { height: 9px; border: 2px solid #000; margin-top: 5px; }
  .codex-half-vertical .fill { height: 100%; background: #000; }
</style>
<div class="screen codex-half-vertical">
  <div class="view"><div class="layout layout--col">
    <div class="quota-stack">
      {% for quota in quotas limit:3 %}
        <div class="quota-card">
          <div class="label">{{ quota.label | escape }}</div>
          <div class="percent">{{ quota.used_pct }}%</div>
          <div class="detail">{{ quota.used | escape }} / {{ quota.limit | escape }}</div>
          <div class="meter"><div class="fill" style="width: {{ quota.used_pct }}%"></div></div>
          <div class="detail">Reset {{ quota.reset | escape }}</div>
        </div>
      {% else %}
        <div class="quota-card"><div class="label">Waiting for data</div><div class="detail">Send your first payload.</div></div>
      {% endfor %}
    </div>
  </div></div>
  <div class="title_bar"><span class="title">{{ trmnl.plugin_settings.custom_fields_values.display_name | default: account_label | default: "Codex usage" | escape }}</span><span class="instance">Updated {{ updated_at | default: "—" | escape }}</span></div>
</div>
