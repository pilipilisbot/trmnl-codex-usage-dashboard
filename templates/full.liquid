<link rel="stylesheet" href="https://trmnl.com/css/latest/plugins.css">
<style>
  .codex-dashboard { font-family: system-ui, sans-serif; }
  .codex-grid { display: grid; grid-template-columns: 256px 1fr; gap: 18px; height: 406px; }
  .quota-stack { display: grid; grid-template-rows: repeat(3, minmax(0, 1fr)); gap: 8px; }
  .quota-box, .panel { border: 2px solid #000; border-radius: 6px; padding: 10px; background: #fff; overflow: hidden; }
  .quota-label, .panel-title, .row-label { font-size: 18px; font-weight: 700; line-height: 1.05; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .quota-value { margin-top: 4px; font-size: 28px; font-weight: 800; line-height: 1; }
  .quota-meta, .muted { margin-top: 3px; font-size: 13px; color: #333; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .meter { margin-top: 5px; height: 9px; border: 2px solid #000; background: repeating-linear-gradient(45deg, #fff, #fff 3px, #ddd 3px, #ddd 6px); }
  .meter-fill, .thin-meter-fill { height: 100%; background: #000; }
  .main-stack { display: grid; grid-template-rows: 194px 1fr; gap: 14px; }
  .daily-bars { display: grid; grid-template-columns: repeat(7, 1fr); align-items: end; gap: 10px; height: 128px; margin-top: 12px; border-bottom: 2px solid #000; }
  .day { display: flex; flex-direction: column; justify-content: flex-end; height: 128px; }
  .day-bar { min-height: 6px; border: 2px solid #000; background: #000; }
  .day-label { margin-top: 5px; text-align: center; font-size: 13px; font-weight: 700; }
  .bottom-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .rows { display: grid; gap: 8px; margin-top: 12px; }
  .row { display: grid; grid-template-columns: 104px 1fr 54px; gap: 8px; align-items: center; }
  .recent-row { display: grid; grid-template-columns: 1fr 62px; gap: 8px; align-items: baseline; }
  .thin-meter { height: 9px; border: 1px solid #000; background: #fff; }
  .row-value { text-align: right; font-size: 14px; font-weight: 700; }
  .empty { margin-top: 16px; font-size: 16px; }
</style>
<div class="screen codex-dashboard">
  <div class="view">
    <div class="layout layout--col">
      <div class="codex-grid">
        <div class="quota-stack">
          {% for quota in quotas limit:3 %}
            <div class="quota-box">
              <div class="quota-label">{{ quota.label | escape }}</div>
              <div class="quota-value">{{ quota.used_pct }}%</div>
              <div class="quota-meta">{{ quota.used | escape }} / {{ quota.limit | escape }}</div>
              <div class="meter"><div class="meter-fill" style="width: {{ quota.used_pct }}%"></div></div>
              <div class="muted">Reset {{ quota.reset | escape }}</div>
            </div>
          {% else %}
            <div class="quota-box"><div class="quota-label">Waiting for data</div><div class="muted">Send your first usage payload.</div></div>
          {% endfor %}
        </div>
        <div class="main-stack">
          <div class="panel">
            <div class="panel-title">Daily usage</div>
            <div class="daily-bars">
              {% for day in daily_usage limit:7 %}
                <div class="day"><div class="day-bar" style="height: {{ day.pct }}%"></div><div class="day-label">{{ day.label | escape }}</div></div>
              {% endfor %}
            </div>
          </div>
          <div class="bottom-grid">
            <div class="panel">
              <div class="panel-title">Models</div>
              <div class="rows">
                {% for model in models limit:4 %}
                  <div class="row"><div class="row-label">{{ model.name | escape }}</div><div class="thin-meter"><div class="thin-meter-fill" style="width: {{ model.pct }}%"></div></div><div class="row-value">{{ model.value | escape }}</div></div>
                {% else %}<div class="empty">No model data</div>{% endfor %}
              </div>
            </div>
            <div class="panel">
              <div class="panel-title">Recent activity</div>
              <div class="rows">
                {% for item in recent limit:4 %}
                  <div class="recent-row"><div class="row-label">{{ item.label | escape }}</div><div class="row-value">{{ item.value | escape }}</div></div>
                {% else %}<div class="empty">No activity</div>{% endfor %}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="title_bar">
      <span class="title">{{ trmnl.plugin_settings.custom_fields_values.display_name | default: account_label | default: "Codex usage" | escape }}</span>
      <span class="instance">Updated {{ updated_at | default: "—" | escape }}</span>
    </div>
  </div>
</div>
