<link rel="stylesheet" href="https://trmnl.com/css/latest/plugins.css">
<script src="https://trmnl.com/js/latest/plugins.js"></script>

<style>
  .codex-dashboard {
    font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }

  .codex-grid {
    display: grid;
    grid-template-columns: 256px 1fr;
    gap: 18px;
    height: 406px;
  }

  .quota-stack {
    display: grid;
    grid-template-rows: repeat(3, 1fr);
    gap: 10px;
  }

  .quota-box,
  .panel {
    border: 2px solid #000;
    border-radius: 6px;
    padding: 12px;
    background: #fff;
  }

  .quota-label,
  .panel-title,
  .row-label,
  .bar-label {
    font-size: 18px;
    font-weight: 700;
    line-height: 1.05;
  }

  .quota-value {
    margin-top: 8px;
    font-size: 34px;
    font-weight: 800;
    line-height: 1;
  }

  .quota-meta,
  .muted {
    margin-top: 6px;
    font-size: 14px;
    color: #333;
  }

  .meter {
    margin-top: 10px;
    height: 12px;
    border: 2px solid #000;
    background: repeating-linear-gradient(
      45deg,
      #fff,
      #fff 3px,
      #ddd 3px,
      #ddd 6px
    );
  }

  .meter-fill {
    height: 100%;
    background: #000;
  }

  .main-stack {
    display: grid;
    grid-template-rows: 194px 1fr;
    gap: 14px;
  }

  .daily-bars {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    align-items: end;
    gap: 10px;
    height: 128px;
    margin-top: 12px;
    border-bottom: 2px solid #000;
  }

  .day {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    height: 128px;
  }

  .day-bar {
    min-height: 6px;
    border: 2px solid #000;
    background: #000;
  }

  .day-label {
    margin-top: 5px;
    text-align: center;
    font-size: 13px;
    font-weight: 700;
  }

  .bottom-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }

  .rows {
    display: grid;
    gap: 8px;
    margin-top: 12px;
  }

  .row {
    display: grid;
    grid-template-columns: 104px 1fr 54px;
    gap: 8px;
    align-items: center;
  }

  .recent-row {
    display: grid;
    grid-template-columns: 1fr 62px;
    gap: 8px;
    align-items: baseline;
  }

  .thin-meter {
    height: 9px;
    border: 1px solid #000;
    background: #fff;
  }

  .thin-meter-fill {
    height: 100%;
    background: #000;
  }

  .row-value {
    text-align: right;
    font-size: 14px;
    font-weight: 700;
  }
</style>

<div class="screen codex-dashboard">
  <div class="view view--full">
    <div class="layout layout--col">
      <div class="codex-grid">
        <div class="quota-stack">
          <div class="quota-box">
            <div class="quota-label">5h quota</div>
            <div class="quota-value">{{ five_hour_used_pct }}%</div>
            <div class="quota-meta">{{ five_hour_used }} / {{ five_hour_limit }}</div>
            <div class="meter"><div class="meter-fill" style="width: {{ five_hour_used_pct }}%"></div></div>
            <div class="muted">Reset {{ five_hour_reset }}</div>
          </div>

          <div class="quota-box">
            <div class="quota-label">Weekly quota</div>
            <div class="quota-value">{{ weekly_used_pct }}%</div>
            <div class="quota-meta">{{ weekly_used }} / {{ weekly_limit }}</div>
            <div class="meter"><div class="meter-fill" style="width: {{ weekly_used_pct }}%"></div></div>
            <div class="muted">Reset {{ weekly_reset }}</div>
          </div>

          <div class="quota-box">
            <div class="quota-label">Spark</div>
            <div class="quota-value">{{ spark_used_pct }}%</div>
            <div class="quota-meta">{{ spark_used }} / {{ spark_limit }}</div>
            <div class="meter"><div class="meter-fill" style="width: {{ spark_used_pct }}%"></div></div>
            <div class="muted">Reset {{ spark_reset }}</div>
          </div>
        </div>

        <div class="main-stack">
          <div class="panel">
            <div class="panel-title">Daily usage</div>
            <div class="daily-bars">
              {% for day in daily_usage %}
                <div class="day">
                  <div class="day-bar" style="height: {{ day.pct }}%"></div>
                  <div class="day-label">{{ day.label }}</div>
                </div>
              {% endfor %}
            </div>
          </div>

          <div class="bottom-grid">
            <div class="panel">
              <div class="panel-title">Models</div>
              <div class="rows">
                {% for model in models %}
                  <div class="row">
                    <div class="row-label">{{ model.name }}</div>
                    <div class="thin-meter"><div class="thin-meter-fill" style="width: {{ model.pct }}%"></div></div>
                    <div class="row-value">{{ model.value }}</div>
                  </div>
                {% endfor %}
              </div>
            </div>

            <div class="panel">
              <div class="panel-title">Recent work</div>
              <div class="rows">
                {% for item in recent %}
                  <div class="recent-row">
                    <div class="row-label">{{ item.label }}</div>
                    <div class="row-value">{{ item.value }}</div>
                  </div>
                {% endfor %}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="title_bar">
      <span class="title">Analitica de Codex</span>
      <span class="instance">Updated {{ updated_at }}</span>
    </div>
  </div>
</div>
