<style>
  .codex-dashboard { width: 100%; height: 100%; min-height: 0; display: flex; flex-direction: column; box-sizing: border-box; }
  .codex-dashboard .codex-grid { display: grid; grid-template-columns: minmax(0, 30%) minmax(0, 1fr); gap: 12px; min-height: 0; flex: 1; }
  .codex-dashboard .quota-stack { display: grid; grid-template-rows: repeat(3, minmax(0, 1fr)); gap: 8px; }
  .codex-dashboard .quota-box, .codex-dashboard .panel { min-width: 0; min-height: 0; border: 2px solid #000; background: #fff; overflow: hidden; }
  .codex-dashboard .quota-label, .codex-dashboard .panel-title, .codex-dashboard .row-label { line-height: 1.05; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .codex-dashboard .quota-value { line-height: 1; }
  .codex-dashboard .quota-meta, .codex-dashboard .muted { color: #333; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .codex-dashboard .meter { height: 9px; border: 2px solid #000; background: repeating-linear-gradient(45deg, #fff, #fff 3px, #ddd 3px, #ddd 6px); }
  .codex-dashboard .meter-fill, .codex-dashboard .thin-meter-fill { height: 100%; background: #000; }
  .codex-dashboard .main-stack { display: grid; grid-template-rows: minmax(0, 48%) minmax(0, 1fr); gap: 10px; min-height: 0; }
  .codex-dashboard .daily-bars { display: grid; grid-template-columns: repeat(7, 1fr); align-items: end; gap: 10px; height: 70%; border-bottom: 2px solid #000; }
  .codex-dashboard .day { display: flex; flex-direction: column; height: 100%; }
  .codex-dashboard .day-bar { min-height: 6px; border: 2px solid #000; background: #000; }
  .codex-dashboard .bottom-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; min-height: 0; }
  .codex-dashboard .rows { display: grid; gap: 8px; }
  .codex-dashboard .row { display: grid; grid-template-columns: minmax(0, 1fr) minmax(20px, 1fr) auto; gap: 8px; align-items: center; }
  .codex-dashboard .recent-row { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 8px; align-items: baseline; }
  .codex-dashboard .thin-meter { height: 9px; border: 1px solid #000; background: #fff; }
  .codex-dashboard .codex-footer { line-height: 1.2; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  /* TRMNL X portrait uses a 1404px-wide canvas, not a narrow viewport. */
  .screen--portrait .codex-dashboard .codex-grid { grid-template-columns: minmax(0, 1fr); grid-template-rows: minmax(0, 29%) minmax(0, 1fr); }
  .screen--portrait .codex-dashboard .quota-stack { grid-template-columns: repeat(3, minmax(0, 1fr)); grid-template-rows: minmax(0, 1fr); }
</style>
<div class="codex-dashboard">
      <div class="codex-grid">
        <div class="quota-stack">
          {% for quota in quotas limit:3 %}
            <div class="quota-box p-2 rounded-md">
              <div class="quota-label title title--small lg:title--large">{{ quota.label | escape }}</div>
              <div class="quota-value mt-1 value value--small lg:value--xlarge lg:portrait:value--xxlarge">{{ quota.used_pct }}%</div>
              <div class="quota-meta mt-1 label lg:label--large lg:portrait:label--xlarge">{{ quota.used | escape }} / {{ quota.limit | escape }}</div>
              <div class="meter mt-1"><div class="meter-fill" style="width: {{ quota.used_pct }}%"></div></div>
              <div class="muted mt-1 label lg:label--large lg:portrait:label--xlarge">Reset {{ quota.reset | escape }}</div>
            </div>
          {% else %}
            <div class="quota-box p-2 rounded-md"><div class="quota-label title title--small lg:title--large">Waiting for data</div><div class="muted mt-1 label lg:label--large lg:portrait:label--xlarge">Send your first usage payload.</div></div>
          {% endfor %}
        </div>
        <div class="main-stack">
          <div class="panel p-2 rounded-md">
            <div class="panel-title title title--small lg:title--large">Daily usage</div>
            <div class="daily-bars mt-2">
              {% for day in daily_usage limit:7 %}
                <div class="day justify-end"><div class="day-bar" style="height: {{ day.pct }}%"></div><div class="day-label mt-1 text-center label lg:label--large">{{ day.label | escape }}</div></div>
              {% endfor %}
            </div>
          </div>
          <div class="bottom-grid">
            <div class="panel p-2 rounded-md">
              <div class="panel-title title title--small lg:title--large">Models</div>
              <div class="rows mt-3">
                {% for model in models limit:4 %}
                  <div class="row"><div class="row-label label lg:label--large">{{ model.name | escape }}</div><div class="thin-meter"><div class="thin-meter-fill" style="width: {{ model.pct }}%"></div></div><div class="row-value text-right label lg:label--large">{{ model.value | escape }}</div></div>
                {% else %}<div class="empty mt-4 label lg:label--large">No model data</div>{% endfor %}
              </div>
            </div>
            <div class="panel p-2 rounded-md">
              <div class="panel-title title title--small lg:title--large">Recent activity</div>
              <div class="rows mt-3">
                {% for item in recent limit:4 %}
                  <div class="recent-row"><div class="row-label label lg:label--large">{{ item.label | escape }}</div><div class="row-value text-right label lg:label--large">{{ item.value | escape }}</div></div>
                {% else %}<div class="empty mt-4 label lg:label--large">No activity</div>{% endfor %}
              </div>
            </div>
          </div>
        </div>
      </div>
  <div class="codex-footer pt-1 label label--small lg:label--base">{{ trmnl.plugin_settings.custom_fields_values.display_name | default: account_label | default: "Codex usage" | escape }} · Updated {{ updated_at | default: "—" | escape }}</div>
</div>
