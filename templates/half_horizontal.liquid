<style>
  .codex-half-horizontal { width: 100%; height: 100%; min-height: 0; display: flex; flex-direction: column; box-sizing: border-box; }
  .codex-half-horizontal .quota-row { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; min-height: 0; flex: 1; }
  .codex-half-horizontal .quota-card { border: 2px solid #000; border-radius: 6px; padding: 10px; overflow: hidden; }
  .codex-half-horizontal .quota-name { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .codex-half-horizontal .percent { line-height: 1.1; }
  .codex-half-horizontal .detail { margin-top: 4px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .codex-half-horizontal .meter { height: 12px; border: 2px solid #000; margin-top: 8px; }
  .codex-half-horizontal .fill { height: 100%; background: #000; }
  .codex-half-horizontal .codex-footer { line-height: 1.2; padding-top: 4px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
</style>
<div class="codex-half-horizontal">
    <div class="quota-row">
      {% for quota in quotas limit:3 %}
        <div class="quota-card">
          <div class="quota-name title title--small lg:title--large">{{ quota.label | escape }}</div>
          <div class="percent value lg:value--xlarge">{{ quota.used_pct }}%</div>
          <div class="detail label lg:label--large">{{ quota.used | escape }} / {{ quota.limit | escape }}</div>
          <div class="meter"><div class="fill" style="width: {{ quota.used_pct }}%"></div></div>
          <div class="detail label lg:label--large">Reset {{ quota.reset | escape }}</div>
        </div>
      {% else %}
        <div class="quota-card"><div class="quota-name title title--small lg:title--large">Waiting for data</div><div class="detail label lg:label--large">Send your first payload.</div></div>
      {% endfor %}
    </div>
  <div class="codex-footer label label--small lg:label--base">{{ trmnl.plugin_settings.custom_fields_values.display_name | default: account_label | default: "Codex usage" | escape }} · Updated {{ updated_at | default: "—" | escape }}</div>
</div>
