<style>
  .codex-quadrant { width: 100%; height: 100%; min-height: 0; display: flex; flex-direction: column; box-sizing: border-box; }
  .codex-quadrant .quota-card { border: 2px solid #000; border-radius: 6px; padding: 12px; min-height: 0; flex: 1; overflow: hidden; }
  .codex-quadrant .label { font-size: 20px; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .codex-quadrant .percent { font-size: 42px; line-height: 1.1; font-weight: 800; }
  .codex-quadrant .detail { font-size: 15px; margin-top: 4px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .codex-quadrant .meter { height: 12px; border: 2px solid #000; margin-top: 8px; }
  .codex-quadrant .fill { height: 100%; background: #000; }
  .codex-quadrant .codex-footer { font-size: 11px; line-height: 1.2; padding-top: 4px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
</style>
<div class="codex-quadrant">
    <div class="quota-card">
      {% for quota in quotas limit:1 %}
        <div class="label">{{ quota.label | escape }}</div>
        <div class="percent">{{ quota.used_pct }}%</div>
        <div class="detail">{{ quota.used | escape }} / {{ quota.limit | escape }}</div>
        <div class="meter"><div class="fill" style="width: {{ quota.used_pct }}%"></div></div>
      {% else %}
        <div class="label">Waiting for data</div><div class="detail">Send your first payload.</div>
      {% endfor %}
    </div>
  <div class="codex-footer">{{ trmnl.plugin_settings.custom_fields_values.display_name | default: account_label | default: "Codex usage" | escape }}</div>
</div>
