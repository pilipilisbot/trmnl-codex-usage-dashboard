<style>
  .codex-quadrant { width: 100%; height: 100%; min-height: 0; display: flex; flex-direction: column; box-sizing: border-box; }
  .codex-quadrant .quota-stack { display: flex; flex-direction: column; min-height: 0; flex: 1; gap: 10px; }
  .codex-quadrant .quota-card { border: 2px solid #000; min-height: 0; flex: 1; overflow: hidden; }
  .codex-quadrant .quota-name { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .codex-quadrant .percent { line-height: 1.1; }
  .codex-quadrant .detail { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .codex-quadrant .meter { height: 12px; border: 2px solid #000; }
  .codex-quadrant .fill { height: 100%; background: #000; }
  .codex-quadrant .codex-footer { line-height: 1.2; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
</style>
<div class="codex-quadrant">
    <div class="quota-stack">
      {% for quota in quotas limit:2 %}
      <div class="quota-card p--12 rounded--small{% unless forloop.first %} hidden lg:portrait:visible{% endunless %}">
        <div class="quota-name title title--small lg:title--large">{{ quota.label | escape }}</div>
        <div class="percent value lg:value--xlarge">{{ quota.used_pct }}%</div>
        <div class="detail mt--4 label lg:label--large">{{ quota.used | escape }} / {{ quota.limit | escape }}</div>
        <div class="meter mt--8"><div class="fill" style="width: {{ quota.used_pct }}%"></div></div>
        <div class="detail mt--4 label lg:label--large">Reset {{ quota.reset | escape }}</div>
      </div>
      {% else %}
        <div class="quota-card p--12 rounded--small"><div class="quota-name title title--small lg:title--large">Waiting for data</div><div class="detail mt--4 label lg:label--large">Send your first payload.</div></div>
      {% endfor %}
    </div>
  <div class="codex-footer pt--4 label label--small lg:label--base">{{ trmnl.plugin_settings.custom_fields_values.display_name | default: account_label | default: "Codex usage" | escape }}</div>
</div>
