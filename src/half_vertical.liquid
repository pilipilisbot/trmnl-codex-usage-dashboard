<style>
  .codex-half-vertical { width: 100%; height: 100%; min-height: 0; display: flex; flex-direction: column; box-sizing: border-box; }
  .codex-half-vertical .quota-stack { display: grid; grid-template-rows: repeat(3, minmax(0, 1fr)); gap: 9px; min-height: 0; flex: 1; }
  .codex-half-vertical .quota-card { border: 2px solid #000; overflow: hidden; }
  .codex-half-vertical .quota-name { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .codex-half-vertical .percent { line-height: 1.1; }
  .codex-half-vertical .detail { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .codex-half-vertical .meter { height: 9px; border: 2px solid #000; }
  .codex-half-vertical .fill { height: 100%; background: #000; }
  .codex-half-vertical .codex-footer { line-height: 1.2; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
</style>
<div class="codex-half-vertical">
    <div class="quota-stack">
      {% for quota in quotas limit:3 %}
        <div class="quota-card p-2 rounded-md">
          <div class="quota-name title title--small lg:title--large lg:portrait:title--xlarge">{{ quota.label | escape }}</div>
          <div class="percent value lg:value--xlarge lg:portrait:value--xxxlarge">{{ quota.used_pct }}%</div>
          <div class="detail mt-1 label lg:label--large lg:portrait:label--xlarge">{{ quota.used | escape }} / {{ quota.limit | escape }}</div>
          <div class="meter mt-1"><div class="fill" style="width: {{ quota.used_pct }}%"></div></div>
          <div class="detail mt-1 label lg:label--large lg:portrait:label--xlarge">Reset {{ quota.reset | escape }}</div>
        </div>
      {% else %}
        <div class="quota-card p-2 rounded-md"><div class="quota-name title title--small lg:title--large lg:portrait:title--xlarge">Waiting for data</div><div class="detail mt-1 label lg:label--large lg:portrait:label--xlarge">Send your first payload.</div></div>
      {% endfor %}
    </div>
  <div class="codex-footer pt-1 label label--small lg:label--base">{{ trmnl.plugin_settings.custom_fields_values.display_name | default: account_label | default: "Codex usage" | escape }} · Updated {{ updated_at | default: "—" | escape }}</div>
</div>
